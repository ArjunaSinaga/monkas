NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-key-proyek-baru

# AI per request (OpenAI). Server-side only, jangan pakai prefix NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1
# Batas biaya (pakai mock lokal: http://127.0.0.1:8787/v1)
OPENAI_TIMEOUT_MS=8000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_CACHE_TTL_MS=600000
OPENAI_MAX_CACHE_ENTRIES=200
OPENAI_MAX_CALLS_PER_HOUR=60
OPENAI_MAX_SPEND_USD=1